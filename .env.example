# StudySync — Environment Variables
# Copy this to .env and fill in your values. Never commit .env to version control.

# Django
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=yourdomain.elasticbeanstalk.com,localhost

# AWS RDS PostgreSQL
RDS_DB_NAME=studysync_db
RDS_USERNAME=studysync_user
RDS_PASSWORD=your-db-password
RDS_HOSTNAME=your-rds-endpoint.rds.amazonaws.com
RDS_PORT=5432

# AWS Credentials (IAM role preferred on EC2/EB)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# AWS SNS
AWS_SNS_REGION=eu-west-1
SNS_STUDENT_TOPIC_ARN=arn:aws:sns:eu-west-1:123456789:studysync-student-notifications
SNS_ADMIN_TOPIC_ARN=arn:aws:sns:eu-west-1:123456789:studysync-admin-alerts

# AWS S3 (set USE_S3=True for production)
USE_S3=False
AWS_STORAGE_BUCKET_NAME=studysync-media-bucket
AWS_S3_REGION_NAME=eu-west-1

# AWS CloudWatch
CLOUDWATCH_ENABLED=True
AWS_CLOUDWATCH_REGION=eu-west-1
CLOUDWATCH_ENV=production

# AWS VPC (populate after running: python timer/vpc_config.py)
VPC_ID=vpc-xxxxxxxxxxxxxxxxx
VPC_SUBNET_ID=subnet-xxxxxxxxxxxxxxxxx
VPC_SECURITY_GROUP_ID=sg-xxxxxxxxxxxxxxxxx
